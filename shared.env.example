# shared.env — copy to shared.env (gitignored); teammates sync out-of-band.
# This file contains NON-SECRET service URLs, public keys, deployed contract addresses.
# Private keys and API keys go in each app's own .env file.

# ---- Chain ----
# Chain: Base Sepolia (chainId 84532). Faucet: https://portal.cdp.coinbase.com/products/faucet
# (email signup, 0.05 ETH / 24h, no mainnet-balance gate).
CHAIN=base_sepolia
CHAIN_RPC_URL=https://sepolia.base.org
VERITY_COMMIT_ADDRESS=0x052934b9db3677b5943a8882CA6bd93868245729
EXPLORER_BASE_URL=https://sepolia.basescan.org/tx/

# ---- Signing authorities (PUBLIC ADDRESSES only — private keys live in apps/onchain/.env) ----
# Each claim type is signed by a different wallet so Basescan shows four distinct
# `committer` addresses. The pitch answer: "separation of attestation authority."
#
# Facility signer          : TAP (1), SIGNAL_CARD (4)                 — "facility backend attests"
# Ombudsman signer         : VOICE (2)                                — "state ombudsman office"
# Verity Care service      : CASEFILE (3)                             — "aggregator / MFCU tool"
# Staff signer             : PROOF_OF_SERVICE (5)                     — "a licensed staff member delivered this service"
FACILITY_SIGNER_ADDRESS=0xB281013450EE41d4634246A927A7663f12153cB3
OMBUDSMAN_SIGNER_ADDRESS=0xD138267Fd0FD4Ecd44dbeF7a1b720176792e538F
VERITY_SERVICE_SIGNER_ADDRESS=0x113B1E33d5DeE49e2e91Bd869A2CFA501B12269F
STAFF_SIGNER_ADDRESS=0xdbbF6AF9F46E85ee39c2448bc807A51cfc4d497B

# Deployer wallet (funded the three signers above). NOT used to sign claims.
DEPLOYER_ADDRESS=0x90ECCCBEEAeD77425399266de9D0Cc6c2EbA9B8f

# ---- Signing ----
# Public verify key for the ed25519 signature on every exported case file.
# Safe to share. MFCU reviewers verify PDFs against this.
VERITY_CARE_SIGNING_PUBKEY_B64=XgW+Mbga3WYxmJ+2Dk2evPbFiOlw66Mx1AEcq4vq3gw=

# ---- Service URLs (local dev) ----
ONCHAIN_SERVICE_URL=http://localhost:8001
DASHBOARD_API_BASE=http://localhost:8000
SPEND_API_BASE=http://localhost:8003
SHIFT_API_BASE=http://localhost:8002

# ---- Claim type constants ----
# Keep these in sync with the Solidity constants.
CLAIM_TAP=1
CLAIM_VOICE=2
CLAIM_CASEFILE=3
CLAIM_SIGNAL_CARD=4
