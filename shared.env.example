# shared.env — copy to shared.env (gitignored); teammates sync out-of-band.
# This file contains NON-SECRET service URLs, public keys, deployed contract addresses.
# Private keys and API keys go in each app's own .env file.

# ---- Chain ----
# Chain: Base Sepolia (chainId 84532). Faucet: https://portal.cdp.coinbase.com/products/faucet
# (email signup, 0.05 ETH / 24h, no mainnet-balance gate).
CHAIN=base_sepolia
CHAIN_RPC_URL=https://sepolia.base.org
VERITY_COMMIT_ADDRESS=            # filled after Dev C deploys at H1
EXPLORER_BASE_URL=https://sepolia.basescan.org/tx/

# ---- Signing ----
# Public verify key for the ed25519 signature on every exported case file.
# Safe to share. MFCU reviewers verify PDFs against this.
VERITY_CARE_SIGNING_PUBKEY_B64=XgW+Mbga3WYxmJ+2Dk2evPbFiOlw66Mx1AEcq4vq3gw=

# ---- Service URLs (local dev) ----
ONCHAIN_SERVICE_URL=http://localhost:8001
DASHBOARD_API_BASE=http://localhost:8000
SPEND_API_BASE=http://localhost:8003
SHIFT_API_BASE=http://localhost:8002

# ---- Claim type constants ----
# Keep these in sync with the Solidity constants.
CLAIM_TAP=1
CLAIM_VOICE=2
CLAIM_CASEFILE=3
CLAIM_SIGNAL_CARD=4
