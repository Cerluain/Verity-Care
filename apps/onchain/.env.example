# apps/onchain/.env.example - DEV C ONLY.
# Copy to .env and fill private keys. Addresses are already public in shared.env.example.

# ---- Chain ----
CHAIN=base_sepolia
CHAIN_RPC_URL=https://sepolia.base.org
VERITY_COMMIT_ADDRESS=0xF80621cD9EFeC0529fAb805866D84Fbb8a405f45
EXPLORER_BASE_URL=https://sepolia.basescan.org/tx/

# ---- Three signing wallets (route by claim_type) ----
# Addresses are public, in shared.env.example. Fill private keys here (GITIGNORED).
FACILITY_SIGNER_PRIVATE_KEY=0x               # signs TAP (1) + SIGNAL_CARD (4)
OMBUDSMAN_SIGNER_PRIVATE_KEY=0x              # signs VOICE (2)
VERITY_SERVICE_SIGNER_PRIVATE_KEY=0x         # signs CASEFILE (3)

# ---- Case-file signing key (ed25519, base64) ----
ED25519_SIGNING_KEY_B64=

# ---- Mode ----
MOCK=false
LOG_FILE=./data/commit-log.jsonl
