# apps/onchain/.env - DEV C ONLY, never commit the filled version.

# ---- Chain ----
CHAIN=base_sepolia                   # one of: base_sepolia | arbitrum_sepolia | solana_devnet | mock
CHAIN_RPC_URL=                       # filled after H0 chain pick
VERITY_COMMIT_ADDRESS=               # filled after Dev C deploys at H1
EXPLORER_BASE_URL=                   # e.g. https://sepolia.basescan.org/tx/

# ---- Keys ----
VERITY_COMMIT_PRIVATE_KEY=0x         # hot wallet for on-chain commits
ED25519_SIGNING_KEY_B64=             # case-file signing key (generated at H1)

# ---- Mode ----
MOCK=false                           # true = short-circuit chain calls, return fake tx hashes
LOG_FILE=./data/commit-log.jsonl     # append-only local log for audit + /commits endpoint
